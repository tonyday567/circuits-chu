cabal-version: 3.0
name: circuits-chu
version: 0.3.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-chu#readme
bug-reports: https://github.com/tonyday567/circuits-chu/issues
synopsis: Chu construction for circuits
description:
  The Chu construction and its linear-logic connectives, built on top of the
  circuits substrate.  This package is intentionally separate: Chu is a
  star-autonomous model, not part of the circuit substrate itself.

build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-chu

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.Chu

  build-depends:
    base >=4.20 && <5,
    circuits >=0.3 && <0.4,

executable circuits-chu-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  main-is: axioma.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    circuits >=0.3 && <0.4,
    circuits-chu,
    circuits:{circuits-test-utils},
    these >=1.1 && <1.3,
